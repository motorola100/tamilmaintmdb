# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/tamilmv_db

# TMDB API v3 key (optional, but required for TMDB matching/details)
TMDB_API_KEY=YOUR_TMDB_API_KEY

TAMILMV_URL=https://www.1tamilmv.capital/
MAX_WORKERS=8
INITIAL_LIMIT=30
CHECK_INTERVAL_SECONDS=60
PORT=5000
LOG_LEVEL=INFO
